const { scrapeTotalWine } = require("../services/totalwine.scraper");

const scrapeWine = async (req, res) => {
  try {
    await scrapeTotalWine(
      "https://www.totalwine.com/wine/c/c0020",
      "wine"
    );

    res.json({
      success: true,
      message: "Wine scraping completed!",
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({
      success: false,
      message: "Wine scraping failed",
      error: error.message,
    });
  }
};

module.exports = { scrapeWine };
